From 4f84b6e121e9a3455a1a566b318a2fc13dc6fa01 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Zal=C3=A1n=20Demeter?= <zalan.demeter@industreal.tech>
Date: Mon, 26 Oct 2026 15:58:38 +0100
Subject: [PATCH] gles3: leave the identity colour epilogue out of unshaded
 pixels

On GPUs without fast transcendentals (Vivante GC7000UL) the scene shader's
colour epilogue is most of an unshaded pixel: linear_to_srgb's pow 5.6 ms,
the tonemapper if-chain 2.0 ms, the per-pixel exposure and luminance reads
2.0 ms and srgb_to_linear 1.4 ms per 1280x800 frame.

- The linear tonemapper is the identity: APPLY_TONEMAPPING is left unset.
- Exposure and luminance multiplier at 1: new NEUTRAL_EXPOSURE spec constant.
- Unshaded, no fog, linear, neutral: the sRGB round trip is skipped
  (SRGB_PASSTHROUGH); the colour written is the material's own sRGB value.
---
 drivers/gles3/rasterizer_scene_gles3.cpp | 10 +++++++++-
 drivers/gles3/shaders/scene.glsl         | 19 +++++++++++++++++++
 2 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/drivers/gles3/rasterizer_scene_gles3.cpp b/drivers/gles3/rasterizer_scene_gles3.cpp
index bf41012..42dd076 100644
--- a/drivers/gles3/rasterizer_scene_gles3.cpp
+++ b/drivers/gles3/rasterizer_scene_gles3.cpp
@@ -2829,9 +2829,17 @@ void RasterizerSceneGLES3::render_scene(const Ref<RenderSceneBuffers> &p_render_
 			spec_constant_base_flags |= SceneShaderGLES3::USE_DEPTH_FOG;
 		}
 
-		if (!apply_environment_effects_in_post) {
+		// industREAL panel patch: the linear tonemapper is the identity, so leave its code out
+		// rather than branch on a uniform per pixel (~2 ms a full screen on a Vivante GC7000UL).
+		if (!apply_environment_effects_in_post && tonemap_ubo.tonemapper != int32_t(RSE::ENV_TONE_MAPPER_LINEAR)) {
 			spec_constant_base_flags |= SceneShaderGLES3::APPLY_TONEMAPPING;
 		}
+
+		// Exposure and luminance multiplier at 1 multiply by one: leave the per-pixel uniform
+		// reads out (~2 ms a full screen on a Vivante GC7000UL).
+		if (tonemap_ubo.exposure == 1.0f && render_data.luminance_multiplier == 1.0f) {
+			spec_constant_base_flags |= SceneShaderGLES3::NEUTRAL_EXPOSURE;
+		}
 	}
 
 	if (draw_feed && camera_feed_id > -1) {
diff --git a/drivers/gles3/shaders/scene.glsl b/drivers/gles3/shaders/scene.glsl
index cd210e8..dbc61e0 100644
--- a/drivers/gles3/shaders/scene.glsl
+++ b/drivers/gles3/shaders/scene.glsl
@@ -32,6 +32,7 @@ LIGHT_USE_PSSM_BLEND = false
 BASE_PASS = true
 USE_ADDITIVE_LIGHTING = false
 APPLY_TONEMAPPING = true
+NEUTRAL_EXPOSURE = false
 // We can only use one type of light per additive pass. This means that if USE_ADDITIVE_LIGHTING is defined, and
 // these are false, we are doing a directional light pass.
 ADDITIVE_OMNI = false
@@ -2183,6 +2184,14 @@ vec4 textureArray_bicubic(sampler2DArray tex, vec3 uv, vec2 texture_size) {
 #endif //LIGHTMAP_BICUBIC_FILTER
 #endif // RENDER_MOTION_VECTORS
 
+// industREAL panel patch: when nothing between the albedo and the output changes a colour
+// (unshaded, no fog, linear tonemapper, exposure and luminance 1), the sRGB -> linear -> sRGB
+// round trip is the identity, and on GPUs without fast transcendentals (Vivante GC7000UL:
+// ~7 ms per full screen) it is the most expensive part of an unshaded pixel. Skip it.
+#if defined(BASE_PASS) && defined(MODE_UNSHADED) && !defined(RENDER_MATERIAL) && !defined(USE_ADDITIVE_LIGHTING) && !defined(APPLY_TONEMAPPING) && defined(NEUTRAL_EXPOSURE) && (defined(FOG_DISABLED) || (defined(DISABLE_FOG) && !defined(CUSTOM_FOG_USED)))
+#define SRGB_PASSTHROUGH
+#endif
+
 void main() {
 #ifndef RENDER_MOTION_VECTORS
 	//lay out everything, whatever is unused is optimized away anyway
@@ -2394,9 +2403,11 @@ void main() {
 	uint fog_ba = packHalf2x16(fog.ba);
 #endif // !FOG_DISABLED
 
+#ifndef SRGB_PASSTHROUGH
 	// Convert colors to linear
 	albedo = srgb_to_linear(albedo);
 	emission = srgb_to_linear(emission);
+#endif
 	// TODO Backlight and transmittance when used
 #ifndef MODE_UNSHADED
 	vec3 f0 = F0(metallic, specular, albedo);
@@ -2791,11 +2802,15 @@ void main() {
 #endif // !FOG_DISABLED
 
 	// Tonemap before writing as we are writing to an sRGB framebuffer
+#ifndef NEUTRAL_EXPOSURE
 	frag_color.rgb *= exposure;
+#endif
 #ifdef APPLY_TONEMAPPING
 	frag_color.rgb = apply_tonemapping(frag_color.rgb);
 #endif
+#ifndef SRGB_PASSTHROUGH
 	frag_color.rgb = linear_to_srgb(frag_color.rgb);
+#endif
 
 #else // !BASE_PASS
 	frag_color = vec4(0.0, 0.0, 0.0, alpha);
@@ -3063,7 +3078,9 @@ void main() {
 #endif // !FOG_DISABLED
 
 	// Tonemap before writing as we are writing to an sRGB framebuffer
+#ifndef NEUTRAL_EXPOSURE
 	additive_light_color *= exposure;
+#endif
 #ifdef APPLY_TONEMAPPING
 	additive_light_color = apply_tonemapping(additive_light_color);
 #endif
@@ -3071,7 +3088,9 @@ void main() {
 
 	frag_color.rgb += additive_light_color;
 #endif // USE_ADDITIVE_LIGHTING
+#ifndef NEUTRAL_EXPOSURE
 	frag_color.rgb *= scene_data_block.data.luminance_multiplier;
+#endif
 
 #endif // !RENDER_MATERIAL
 #endif // !MODE_RENDER_DEPTH
-- 
2.43.0

